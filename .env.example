# ============================================
# Jettoken Airdrop Backend Configuration
# ============================================
# Copy this file to .env and fill in your values!
# NEVER share your .env file or commit it to git!

# Your 24-word mnemonic for the admin wallet (the one that controls the Jetton Master)
# This wallet must be the admin/owner of the Jetton Master Contract
MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24

# Your Jetton Master Contract address
JETTON_MASTER=EQB0qpljZl3xD0pbWPM3PCEn6bQfDe6Xx7a7W4qtBs45axmj

# How many tokens to give each user (in TOKEN units, not nano)
# Example: 100 = each user gets 100 jettokens
CLAIM_AMOUNT=100

# Token decimals (usually 9 for TON-based jettons)
TOKEN_DECIMALS=9

# TonCenter API key (get one at https://toncenter.com)
# Free tier: 1 req/sec, Paid: more
TONCENTER_API_KEY=

# Network: mainnet or testnet
NETWORK=mainnet

# Server port
PORT=3001
